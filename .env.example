# Local Node test server only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_TOKENS=token1,token2
PORT=3001

# GitHub Pages frontend (repository variables/secrets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Địa chỉ công khai dùng cho link trong email xác minh. Đặt biến này khi chạy
# local để link xác minh không trỏ về localhost. Phải nằm trong danh sách
# Redirect URLs của Supabase Auth.
VITE_PUBLIC_SITE_URL=https://vuongndlst.github.io/caro-tournament/

# Local Socket.IO backend. This is not used by the final Supabase-only production target.
VITE_SERVER_URL=http://localhost:3001
